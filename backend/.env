# CyberTrace AI Platform Environment Variables
DATABASE_URL=sqlite:///./cybertrace.db
SECRET_KEY=cybertrace-super-secret-key-production-ready-2026-auth-token
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Provider Configuration (Provide your key to activate RAG generative answers)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# RAG & Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_db
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Storage Directories
UPLOAD_DIRECTORY=./storage/evidence
REPORT_DIRECTORY=./storage/reports
TEMP_DIRECTORY=./storage/temporary
MAX_UPLOAD_SIZE_MB=50

FRONTEND_ORIGIN=http://localhost:8000
