# CyberTrace AI Platform Environment Variables
DATABASE_URL=sqlite:///./cybertrace.db
# For PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.dswkfovjcfnsppjnqaym.supabase.co:5432/postgres

SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Supabase Credentials
SUPABASE_URL=https://dswkfovjcfnsppjnqaym.supabase.co
SUPABASE_KEY=your_supabase_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# AI Provider Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# RAG & Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=./chroma_db
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Storage Directories
UPLOAD_DIRECTORY=./storage/evidence
REPORT_DIRECTORY=./storage/reports
TEMP_DIRECTORY=./storage/temporary
MAX_UPLOAD_SIZE_MB=50

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:8000
